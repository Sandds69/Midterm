# -----------------------------------------------------------------------------
# Health Metrics Vault - environment variables
# Copy to .env and fill in real values:   cp .env.example .env
# NEVER commit .env (it is in .gitignore).
# -----------------------------------------------------------------------------

# HTTP port the API listens on
PORT=8080

# Gin mode: release | debug
GIN_MODE=release

# PostgreSQL connection string (local, non-Docker run).
# docker-compose overrides this to point at the "db" service.
DB_DSN=postgres://postgres:1234@localhost:5432/hmv_db?sslmode=disable

# Credentials used by the PostgreSQL container in docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=hmv_db

# JWT HS256 signing secret - at least 32 characters.
# Generate:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_ISSUER=health-metrics-vault
# Token lifetime (Go duration, max 24h)
JWT_TTL=1h

# AES-256-GCM key for Data at Rest encryption: EXACTLY 64 hex chars (32 bytes).
# Generate:  openssl rand -hex 32
# WARNING: losing or changing this key makes existing medical records unreadable.
AES_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_generate_with_openssl_rand_hex_32

# Comma-separated allow-list of frontend origins (no "*")
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
